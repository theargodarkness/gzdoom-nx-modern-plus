diff --git a/source/loader/i_module.cpp b/source/loader/i_module.cpp
index 59742ef..a6c912a 100644
--- a/source/loader/i_module.cpp
+++ b/source/loader/i_module.cpp
@@ -36,8 +36,14 @@
 #ifdef _WIN32
 #define WIN32_LEAN_AND_MEAN
 #include <windows.h>
-#else
+#elif !defined(__SWITCH__)
 #include <dlfcn.h>
+#else
+// No dynamic loader on the Switch; everything is linked statically.
+#define RTLD_LAZY 0
+#define dlopen(x, y) (nullptr)
+#define dlsym(x, y) (nullptr)
+#define dlclose(x)
 #endif
 
 
