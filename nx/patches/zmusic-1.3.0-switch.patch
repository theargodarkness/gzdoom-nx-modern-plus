+
 // MACROS ------------------------------------------------------------------
 
 enum
@@ -290,8 +295,12 @@ MIDIDevice *MIDIStreamer::CreateMIDIDevice(EMidiDevice devtype, int samplerate)
 				// Intentional fall-through for systems without standard midi support
 
 			case MDEV_FLUIDSYNTH:
