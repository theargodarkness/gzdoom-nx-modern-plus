diff --git a/thirdparty/CMakeLists.txt b/thirdparty/CMakeLists.txt
index dd791db..aef7b77 100644
--- a/thirdparty/CMakeLists.txt
+++ b/thirdparty/CMakeLists.txt
@@ -28,4 +28,8 @@ add_subdirectory(timidityplus)
 add_subdirectory(wildmidi)
 add_subdirectory(oplsynth)
 add_subdirectory(libxmp)
-add_subdirectory(fluidsynth/src)
+# The bundled FluidSynth needs glib, which the Nintendo Switch does not have.
+option(ZMUSIC_NO_FLUIDSYNTH "Build without the FluidSynth MIDI device" OFF)
+if(NOT ZMUSIC_NO_FLUIDSYNTH)
+	add_subdirectory(fluidsynth/src)
+endif()
